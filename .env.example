# Optional. Leave blank to use on-device chat/trip/packing/culture.
# Do not put platform/agent keys here.
GEMINI_API_KEY=

# Open-source / OpenAI-compatible LLM (preferred over Gemini when set).
# Examples: Groq, Together, Ollama, vLLM, OpenRouter.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.groq.com/openai/v1
USER_LLM_MODEL=llama-3.3-70b-versatile

# Optional live cash-fare sources (all fail-soft; app works with none set).
# Amadeus self-service test keys (note: public/test catalog was retired in
# 2026 — kept only for accounts that still have entitlements).
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Duffel (real bookable NDC offers; test mode available): https://duffel.com
DUFFEL_API_KEY=

# AviationStack free tier (100 req/month, schedules/status): https://aviationstack.com
AVIATIONSTACK_API_KEY=

APP_URL=
